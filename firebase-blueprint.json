{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "purchasedBundleIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email"]
    },
    "Content": {
      "title": "Content",
      "description": "Educational material (PDF, Video, Course, etc.)",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "type": { "type": "string", "enum": ["pdf", "video", "course", "lesson", "manual", "book"] },
        "author": { "type": "string" },
        "category": { "type": "string" },
        "is_free": { "type": "boolean" },
        "bundle_id": { "type": "string", "description": "If paid, which bundle it belongs to" },
        "file_url": { "type": "string" },
        "thumbnail_url": { "type": "string", "description": "URL for the cover image" },
        "storage_path": { "type": "string" },
        "storage_type": { "type": "string" },
        "user_id": { "type": "string", "description": "Uploader ID" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "category", "is_free", "user_id", "status"]
    },
    "Bundle": {
      "title": "Bundle",
      "description": "A paid package of content (e.g., 2000 Kz bundle)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "description": { "type": "string" },
        "contentIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "price"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/contents/{contentId}": {
      "schema": "Content",
      "description": "All educational materials"
    },
    "/bundles/{bundleId}": {
      "schema": "Bundle",
      "description": "Paid content packages"
    }
  }
}
